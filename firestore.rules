rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Tournaments Collection
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      // Players can register team to tournament
      allow update: if isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredTeamIds']);
    }

    // Teams Collection
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.captainId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.captainId == request.auth.uid || isAdmin());
    }

    // Matches Collection
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Match Results Collection
    match /results/{resultId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Team Invitations
    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.inviteeId == request.auth.uid || resource.data.inviterId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && 
        (resource.data.inviteeId == request.auth.uid || resource.data.inviterId == request.auth.uid || isAdmin());
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Badges Collection
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leaderboards Collection
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
